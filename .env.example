# Copy this file to .env and replace the placeholder with your real API key.
# Never commit the .env file to Git.
LLM_PROVIDER=deepseek

# Optional generic overrides. LLM_MODEL is required for non-DeepSeek providers.
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://example.com/provider-api

# DeepSeek is the only runtime adapter registered in Phase 1.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek's Anthropic-compatible endpoint (used by the anthropic Python SDK).
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash

# Reserved for the Claude and OpenAI adapters added in later phases. These keys
# are validated only when their matching LLM_PROVIDER is selected.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Agent behavior. THINKING_ENABLED accepts true or false.
THINKING_ENABLED=false
SYSTEM_PROMPT="You are Neil Agent, a helpful local coding assistant. Give accurate, practical, and concise answers."

# Generation and loop limits.
MAX_TOKENS=8192
MAX_ROUNDS=20
# Approximate JSON characters for system prompt, tools, history, and new input.
MAX_CONTEXT_CHARS=120000
# Optional model context token soft limit. The local estimate uses DeepSeek's
# documented character ratios; actual usage and billing still come from the API.
# MAX_CONTEXT_TOKENS=64000
MAX_TOOL_ROUNDS=5
REQUEST_TIMEOUT=120
# Transient model failures only. Total attempts are 1 + MAX_RETRIES.
MAX_RETRIES=2
RETRY_BASE_DELAY=1
RETRY_MAX_DELAY=8

# Local tool boundaries. Commands use a fixed allowlist and capped output.
WORKSPACE_ROOT=.
COMMAND_TIMEOUT=120
MAX_COMMAND_OUTPUT_CHARS=20000
# Optional OS-sandbox adapter. This never enables a general command tool by
# itself; unavailable or incomplete platform capabilities fail closed.
SANDBOX_BACKEND=disabled

# Optional metadata-only lifecycle audit. It never records prompts, thinking,
# tool arguments, tool result content, or API keys.
AUDIT_LOG_ENABLED=false
AUDIT_LOG_MAX_BYTES=1000000
