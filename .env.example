# Copy this file to .env and replace the placeholder with your real API key.
# Never commit the .env file to Git.
LLM_PROVIDER=deepseek

# Optional generic overrides. LLM_MODEL is required for non-DeepSeek providers.
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://example.com/provider-api

# DeepSeek remains the backward-compatible default runtime.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek's Anthropic-compatible endpoint (used by the anthropic Python SDK).
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash

# Claude and OpenAI are available with an explicit matching LLM_PROVIDER and
# LLM_MODEL. Keys are validated only when their matching provider is selected.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Ollama and vLLM use their local OpenAI-compatible Responses endpoints by
# default. Set LLM_PROVIDER and LLM_MODEL; no cloud key is required. Secured
# local gateways may use an optional bearer key.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3
# LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_API_KEY=your_optional_local_bearer_key
# Tool support varies by server and model, so it remains fail-closed until the
# operator has verified that exact deployment. Parallel calls are vLLM-only.
LOCAL_TOOL_CALLING_ENABLED=false
LOCAL_PARALLEL_TOOL_CALLS_ENABLED=false

# Agent behavior. THINKING_ENABLED accepts true or false.
THINKING_ENABLED=false
# Claude defaults to adaptive thinking when enabled. For older models that use
# manual extended thinking, select enabled and keep the budget below MAX_TOKENS.
CLAUDE_THINKING_MODE=adaptive
CLAUDE_THINKING_BUDGET_TOKENS=1024
# OpenAI reasoning effort: none, minimal, low, medium, high, xhigh, or max.
OPENAI_REASONING_EFFORT=medium
SYSTEM_PROMPT="You are Neil Agent, a helpful local coding assistant. Give accurate, practical, and concise answers."

# Generation and loop limits.
MAX_TOKENS=8192
MAX_ROUNDS=20
# Approximate JSON characters for system prompt, tools, history, and new input.
MAX_CONTEXT_CHARS=120000
# Optional model context token soft limit. The local estimate uses DeepSeek's
# documented character ratios; actual usage and billing still come from the API.
# MAX_CONTEXT_TOKENS=64000
MAX_TOOL_ROUNDS=5
REQUEST_TIMEOUT=120
# Transient model failures only. Total attempts are 1 + MAX_RETRIES.
MAX_RETRIES=2
RETRY_BASE_DELAY=1
RETRY_MAX_DELAY=8

# Local tool boundaries. Commands use a fixed allowlist and capped output.
WORKSPACE_ROOT=.
COMMAND_TIMEOUT=120
MAX_COMMAND_OUTPUT_CHARS=20000
# Optional local JSON table for Web Workbench cost estimates. The table must
# carry an explicit version and effective date; without it Cost stays unavailable.
# WEB_RATE_TABLE=C:/path/to/provider-rates.json
# Optional Web-only, same-provider model choices. This must be a JSON array with
# at most 15 additional exact model IDs. The startup model is included
# automatically; switching remains disabled unless at least one choice is set.
# WEB_RUNTIME_MODEL_ALLOWLIST=["deepseek-fast","deepseek-reasoning"]
# Optional OS-sandbox adapter. This never enables a general command tool by
# itself; unavailable or incomplete platform capabilities fail closed.
SANDBOX_BACKEND=disabled

# Optional metadata-only lifecycle audit. It never records prompts, thinking,
# tool arguments, tool result content, or API keys.
AUDIT_LOG_ENABLED=false
AUDIT_LOG_MAX_BYTES=1000000
