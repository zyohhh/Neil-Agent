    "id": "terminal-state-history",
    "title": "Reject incomplete responses before committing conversation history",
    "prompt": "Repair terminal.py and conversation.py. Only end_turn without calls and tool_call with calls are consistent terminal states; all other reasons are invalid. finish_turn must reject invalid states, blank user input and blank final replies with ValueError. Pending tool calls must leave history unchanged; successful final replies append one user/assistant pair. Always return a deep copy and never mutate or alias input history. Preserve both public signatures. This is an adapted repository regression fixture, not the full application.",
    "files": {
      "terminal.py": "def terminal_is_consistent(reason, calls):\n    return reason != \"error\"\n",
      "conversation.py": "from terminal import terminal_is_consistent\n\n\ndef finish_turn(history, user, text, reason, calls):\n    if not terminal_is_consistent(reason, calls):\n        raise ValueError(\"invalid terminal state\")\n    history.extend([{\"role\": \"user\", \"content\": user}, {\"role\": \"assistant\", \"content\": text}])\n    return history\n"
    },
    "editable_files": [
