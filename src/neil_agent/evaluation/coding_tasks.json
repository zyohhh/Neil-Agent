              0,
              ""
            ]
          }
        ],
        "expected": "ec97e754979c0668f9f06b697f6ecab62ae43c8596e05522bf9013a30e1df14f",
        "identity": "any"
      },
      {
        "module": "store",
        "function": "plan_save",
        "args": [
          {
            "session_id": "session-1",
            "title": "original",
            "runtime_provider": "deepseek",
            "runtime_model": "model-a",
            "messages": [
              {
                "text": "old"
              }
            ]
          },
