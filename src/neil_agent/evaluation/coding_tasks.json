        "module": "versions",
        "function": "snapshot_digest",
        "args": [
          {
            "b": 2,
            "a": 1
          }
        ],
        "expected": "43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777",
        "identity": "any"
      },
      {
        "module": "versions",
        "function": "snapshot_digest",
        "args": [
          {
            "a": 1,
            "b": 2
          }
        ],
        "expected": "43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777",
        "identity": "any"
      },
      {
        "module": "versions",
        "function": "snapshot_digest",
