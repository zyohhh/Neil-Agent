  {
    "id": "session-revision-save",
    "title": "Compare loaded revisions before planning a session save",
    "prompt": "Fix versions.py and store.py. snapshot_digest is SHA-256 of UTF-8 JSON with sorted keys, ensure_ascii=False and compact separators. plan_save returns an independent deep copy of incoming; it must never mutate inputs. None current with None expected means creation. Reject stale digests, deleted loaded snapshots, create-only collisions, changed session_id and changes to a bound runtime_provider/runtime_model using ValueError. A non-None provider is bound. Keep public signatures. The fixture plans a save only; do not add file I/O or locks. This is an adapted repository regression fixture.",
    "files": {
      "versions.py": "import hashlib\n\n\ndef snapshot_digest(snapshot):\n    return hashlib.sha256(str(snapshot).encode()).hexdigest()\n",
      "store.py": "from versions import snapshot_digest\n\n\ndef plan_save(current, expected_digest, incoming):\n    return incoming\n"
    },
    "editable_files": [
      "versions.py",
      "store.py"
    ],
    "reference_files": {
      "versions.py": "import hashlib\nimport json\n\n\ndef snapshot_digest(snapshot):\n    canonical = json.dumps(snapshot, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n    return hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()\n",
      "store.py": "from copy import deepcopy\nfrom versions import snapshot_digest\n\n\ndef plan_save(current, expected_digest, incoming):\n    if current is None:\n        if expected_digest is not None:\n            raise ValueError(\"loaded snapshot was deleted\")\n    else:\n        if expected_digest is None or snapshot_digest(current) != expected_digest:\n            raise ValueError(\"stale revision or create-only conflict\")\n        if current.get(\"session_id\") != incoming.get(\"session_id\"):\n            raise ValueError(\"session identity changed\")\n        if current.get(\"runtime_provider\") is not None and any(current.get(key) != incoming.get(key) for key in (\"runtime_provider\", \"runtime_model\")):\n            raise ValueError(\"bound model changed\")\n    return deepcopy(incoming)\n"
    },
