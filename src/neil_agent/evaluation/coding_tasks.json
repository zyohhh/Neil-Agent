  {
    "id": "config-precedence",
    "title": "Preserve nested defaults and false CLI values",
    "prompt": "Fix configuration precedence across config_reader.py and cli_options.py. merge_config must recursively merge mapping overrides into defaults without mutating or aliasing either input, preserving untouched nested values and replacing non-mapping values. apply_cli must override with explicit False, 0 and empty string values, while None means omitted. Preserve the public function signatures and use only the standard library. Change only these two files.",
    "files": {
      "config_reader.py": "def merge_config(defaults, overrides):\n    result = defaults\n    for key, value in overrides.items():\n        if isinstance(value, dict) and isinstance(result.get(key), dict):\n            result[key].update(value)\n        else:\n            result[key] = value\n    return result\n",
      "cli_options.py": "def apply_cli(config, args):\n    result = dict(config)\n    for key, value in args.items():\n        if value:\n            result[key] = value\n    return result\n"
    },
    "editable_files": [
      "config_reader.py",
      "cli_options.py"
    ],
    "reference_files": {
      "config_reader.py": "from copy import deepcopy\n\n\ndef merge_config(defaults, overrides):\n    result = deepcopy(defaults)\n    for key, value in overrides.items():\n        if isinstance(value, dict) and isinstance(result.get(key), dict):\n            result[key] = merge_config(result[key], value)\n        else:\n            result[key] = deepcopy(value)\n    return result\n",
      "cli_options.py": "def apply_cli(config, args):\n    result = dict(config)\n    for key, value in args.items():\n        if value is not None:\n            result[key] = value\n    return result\n"
    },
    "cases": [
      {
        "module": "config_reader",
        "function": "merge_config",
        "args": [
          {
            "server": {
              "port": 80,
              "tls": {
                "enabled": true,
                "ca": "root"
              }
            },
            "tags": [
              "a"
            ]
          },
          {
            "server": {
              "port": 8080,
              "tls": {
                "enabled": false
              }
            },
            "new": [
              1
            ]
          }
        ],
        "expected": {
          "server": {
            "port": 8080,
            "tls": {
              "enabled": false,
              "ca": "root"
            }
          },
          "tags": [
            "a"
          ],
          "new": [
