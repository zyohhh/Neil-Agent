      "conversation.py"
    ],
    "reference_files": {
      "terminal.py": "def terminal_is_consistent(reason, calls):\n    if reason == \"end_turn\":\n        return not calls\n    if reason == \"tool_call\":\n        return bool(calls)\n    return False\n",
      "conversation.py": "from copy import deepcopy\nfrom terminal import terminal_is_consistent\n\n\ndef finish_turn(history, user, text, reason, calls):\n    if not terminal_is_consistent(reason, calls) or not isinstance(user, str) or not user.strip():\n        raise ValueError(\"invalid terminal state or user input\")\n    result = deepcopy(history)\n    if calls:\n        return result\n    if not isinstance(text, str) or not text.strip():\n        raise ValueError(\"empty final response\")\n    result.extend([{\"role\": \"user\", \"content\": user}, {\"role\": \"assistant\", \"content\": text}])\n    return result\n"
    },
