    "id": "pagination-boundaries",
    "title": "Fix one-based pagination boundaries",
    "prompt": "The paginate API uses one-based page numbers. Fix the implementation so the first page, later pages, partial last pages and pages beyond the end work correctly. Preserve validation of positive page and page_size, return a new list, and do not mutate input. Change only pager.py.",
    "files": {
      "pager.py": "def paginate(items, page, page_size):\n    if page < 1 or page_size < 1:\n        raise ValueError(\"page and page_size must be positive\")\n    start = page * page_size\n    return items[start:start + page_size]\n"
    },
    "editable_files": [
      "pager.py"
    ],
    "reference_files": {
      "pager.py": "def paginate(items, page, page_size):\n    if page < 1 or page_size < 1:\n        raise ValueError(\"page and page_size must be positive\")\n    start = (page - 1) * page_size\n    return items[start:start + page_size]\n"
    },
    "cases": [
