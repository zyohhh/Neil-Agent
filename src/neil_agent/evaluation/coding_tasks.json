    "id": "slug-collision",
    "title": "Allocate the first available slug suffix",
    "prompt": "Fix unique_slug so an occupied base slug gets the lowest available numeric suffix starting at 2. Existing names may contain gaps, irrelevant names or high suffixes. Normalize titles with the current lowercase ASCII slug rules, use item for empty normalized titles, and leave the existing collection unchanged. Change only slugs.py.",
    "files": {
      "slugs.py": "import re\n\n\ndef unique_slug(title, existing):\n    base = re.sub(r\"[^a-z0-9]+\", \"-\", title.lower()).strip(\"-\") or \"item\"\n    if base not in existing:\n        return base\n    return f\"{base}-{len(existing) + 1}\"\n"
    },
    "editable_files": [
      "slugs.py"
    ],
    "reference_files": {
      "slugs.py": "import re\n\n\ndef unique_slug(title, existing):\n    base = re.sub(r\"[^a-z0-9]+\", \"-\", title.lower()).strip(\"-\") or \"item\"\n    if base not in existing:\n        return base\n    suffix = 2\n    while f\"{base}-{suffix}\" in existing:\n        suffix += 1\n    return f\"{base}-{suffix}\"\n"
    },
